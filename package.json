{
  "name": "sapgui",
  "private": true,
  "version": "0.1.0",
  "description": "SAP GUI transactions in the browser – SE80, SE16N, SM37, ST22 and more, rebuilt as abap2UI5 apps. Pure ABAP, installed with abapGit.",
  "scripts": {
    "lint": "abaplint",
    "lint_standard": "abaplint .github/abaplint/abap_standard.jsonc",
    "lint_abap2ui5": "abap2ui5lint",
    "strip_trailing_ws": "find src -type f -name '*.abap' -exec sed -i 's/[[:space:]]\\+$//' {} +",
    "auto_fix": "abaplint .github/abaplint/auto_fix.jsonc --fix",
    "test": "npm run lint && npm run lint_standard && npm run lint_abap2ui5 && npm run transpile && npm run unit && npm run views",
    "deps": "node node/setup/fetch-deps.mjs",
    "transpile": "npm run deps && node -e \"require('fs').rmSync('node/output',{recursive:true,force:true})\" && abap_transpile node/setup/abap_transpile.json",
    "unit": "node node/setup/run-unit.mjs",
    "views": "node node/setup/snapshot-views.mjs && abap2ui5lint node/views"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/sapgui.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/sapgui/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/sapgui",
  "devDependencies": {
    "@abap2ui5/linter": "^0.8.5",
    "@abap2ui5/linter-render": "^0.8.5",
    "@abaplint/cli": "^2.120.73",
    "@abaplint/database-sqlite": "^2.13.83",
    "@abaplint/runtime": "^2.14.3",
    "@abaplint/transpiler-cli": "^2.14.3"
  }
}
