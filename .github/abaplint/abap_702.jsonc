// Syntax check for the downported 702 branch.
// `npm run auto_downport` runs this config with --fix, which rewrites the
// sources to 7.02 syntax; the 702 branch is then checked with it as is.
{
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps/open-abap-core",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "702",
      "folder": "/deps/abap2ui5-702",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/ai-demokit",
      "folder": "/deps/ai-demokit",
      "files": "/src/z2ui5_cl_ai_xml.clas.*"
    },
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps/steampunk",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "^(Z|Y)",
    "globalConstants": [
      "seok_access_modify"
    ]
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "definitions_top": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "parser_702_chaining": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
