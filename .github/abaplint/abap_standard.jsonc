// Syntax check against a standard on-premise stack (SAP_BASIS 7.50).
// Only syntax/consistency rules - style is checked by the root abaplint.jsonc.
{
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/deps/abap2ui5",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/ai-demokit",
      "folder": "/deps/ai-demokit",
      "files": "/src/z2ui5_cl_ai_xml.clas.*"
    },
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps/steampunk",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y)",
    "globalConstants": [
      "seok_access_modify"
    ]
  },
  "rules": {
    "begin_end_names": true,
    "cds_parser_error": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "sql_escape_host_variables": true,
    "strict_sql": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
